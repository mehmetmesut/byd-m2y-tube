-                && System.currentTimeMillis() - mCacheUpdateTime < TOKEN_REFRESH_PERIOD_MS) {
-            return;
-        }
-
-        updateAuthHeaders();
-
-        mCacheUpdateTime = System.currentTimeMillis();
-    }
