<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.liskovsoft.smartyoutubetv2.common">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 (API 34) -->
    <!-- <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" /> -->
    <!-- API level 34 -->
    <!-- <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" /> -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <!-- Android 10 and up. Start from background permission. Settings/Apps/Draw over other apps (disabled by default) -->
    <!-- https://developer.android.com/guide/components/activities/background-starts -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACTION_MANAGE_OVERLAY_PERMISSION" />
    <!-- <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" /> -->
    <!-- Android 9+: needed to run package uninstaller (ATV, Amazon bride) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES"/>
    <!-- Starting targetSDK 33+, foreground services require explicit permissions in the manifest. -->
    <!-- NOTE: only works with 'mediaPlayback' type service. Others types will fail. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <queries>
        <!-- Android 11+: access the main icon (works for all apps) -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
        </intent>
    </queries>

    <!-- Add requestLegacyExternalStorage to fix unavailable storage on Android 10 (doesn't work on Android 11) -->
    <!-- More info: https://stackoverflow.com/questions/63364476/requestlegacyexternalstorage-is-not-working-in-android-11-api-30 -->
    <application android:requestLegacyExternalStorage="true">
        <!-- M2Y: downloads videos saved for offline viewing -->
        <service
            android:name="com.liskovsoft.smartyoutubetv2.common.m2y.offline.OfflineService"
            android:exported="false"/>
    </application>
</manifest>
